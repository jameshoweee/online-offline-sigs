+     D-cache speeds the SRAM-resident FFT/sampler data. This workload has no DMA
+     and no self-modifying code, so no runtime coherency management is needed. */
+  __asm volatile ("dsb"); __asm volatile ("isb");
+  SCB_ICIALLU = 0;                         /* invalidate entire I-cache */
+  __asm volatile ("dsb"); __asm volatile ("isb");
